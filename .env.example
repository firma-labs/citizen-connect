# Copy to .env.local and fill in. Never commit real keys.

# --- AI (PRD §7.1) ------------------------------------------------------------
# Pilot: the Claude API directly. Without a key the app uses the mock engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_EFFORT=medium
# Per-step override (PRD §7.3 comparison): mock | anthropic:<model> | bedrock:<model>
# AI_READER=anthropic:claude-opus-5
# AI_REASONER=anthropic:claude-sonnet-5
# Production (week 4+, India residency) — Bedrock is used only when set explicitly:
# AI_READER=bedrock:in.anthropic.claude-opus-5
# AWS_REGION=ap-south-1

# --- Storage --------------------------------------------------------------
# On your machine: JSON files and images in .data/ (git-ignored), always.
# On Vercel: the project's connected Vercel Blob store (private, region bom1).
# Vercel adds the Blob credentials itself when the store is connected; nothing
# to set here. STORE=local|blob overrides the automatic choice.

# --- WhatsApp (messages to the citizen) ------------------------------------
# console = log only (pilot; WhatsApp Business number and template not yet approved)
WHATSAPP_PROVIDER=console

# --- Links in WhatsApp messages / QR ----------------------------------------
# Defaults to the request's host (works behind `tailscale serve`).
# PUBLIC_BASE_URL=https://your-host.example


# --- Staff sign-in (pilot) --------------------------------------------------
# User ID = mobile number; one shared password. When both are set, every staff
# screen and API needs sign-in; the citizen status page (/track) stays public.
# On Vercel the app stays locked until these are set.
# DEMO_USERS=9876543210:R. Jadhav,9822012345:A. Patil
# DEMO_PASSWORD=
# Optional signing key for sessions (default: derived from DEMO_PASSWORD, so
# changing the password signs everyone out). Generate: openssl rand -hex 32
# AUTH_SECRET=

# --- AI cost caps ------------------------------------------------------------
# AI readings allowed per day (India date). One reading = 2 model calls (read
# the letter, then classify and route it). Rescans and retries count.
# Per signed-in person (without sign-in, everyone shares one allowance):
# AI_DAILY_LIMIT_PER_USER=20
# Across all staff (0 = no overall cap):
# AI_DAILY_LIMIT_TOTAL=200

# --- Pilot clean-up -----------------------------------------------------------
# Staff can always archive an application (duplicate, test scan, mistake) and
# restore it. Set this to 1 to also allow permanent delete of archived ones —
# for the pilot's test data only; leave it unset in production.
# PILOT_ALLOW_DELETE=1
