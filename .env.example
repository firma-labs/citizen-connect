# Copy to .env.local and fill in. Never commit real keys.

# --- AI (PRD §7.1) ------------------------------------------------------------
# Pilot: the Claude API directly. Without a key the app uses the mock engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_EFFORT=medium
# Per-step override (PRD §7.3 comparison): mock | anthropic:<model> | bedrock:<model>
# AI_READER=anthropic:claude-opus-5
# AI_REASONER=anthropic:claude-sonnet-5
# Production (week 4+, India residency) — Bedrock is used only when set explicitly:
# AI_READER=bedrock:in.anthropic.claude-opus-5
# AWS_REGION=ap-south-1

# --- Storage --------------------------------------------------------------
# STORE=local | supabase   (default: supabase if both vars below are set, else local files in .data/)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PAGES_BUCKET=pages

# --- SMS ------------------------------------------------------------------
# console = log only (pilot; TRAI DLT templates not yet approved)
SMS_PROVIDER=console

# --- Links in SMS / QR ------------------------------------------------------
# Defaults to the request's host (works behind `tailscale serve`).
# PUBLIC_BASE_URL=https://your-host.example

# Optional: show the live camera view (with edge guides) by default
# NEXT_PUBLIC_LIVE_CAMERA=1
